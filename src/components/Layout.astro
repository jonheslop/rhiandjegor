---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
  title: string;
  showLogo?: boolean;
}

const { title, showLogo = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fff" />
    <title>{title} | Rhi & Jegor get married</title>
    <Font cssVariable="--font-abrilfatface" preload />
    <Font cssVariable="--font-vollkorn" preload />
    <meta
      name="description"
      content="Rhi & Jegor are getting married on 26.06.27 in Bristol"
    />
  </head>
  <body class="p-2 md:p-8 font-serif flex flex-col items-center bg-taupe-100 w-full">
    {showLogo && (
      <nav class="text-center w-full flex items-center justify-center">
        <h1 class="font-abril text-5xl font-normal leading-none italic text-orange-500 w-48 mx-auto translate-x-8 mt-8">
          <a href="/" class="flex flex-col items-start">
            <span class="relative z-10">Rhi</span >
            <span class="text-8xl leading-0 text-orange-200 self-center relative z-20 mix-blend-multiply -translate-y-2">&amp;</span>
            <span class="relative z-10 -mt-2.5">Jegor</span>
          </a>
        </h1>
      </nav>
    )}
    <slot />
  </body>
</html>
