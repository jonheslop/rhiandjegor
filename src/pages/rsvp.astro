---
import { actions } from "astro:actions";
import Layout from "../components/Layout.astro";

export const prerender = false;

const result = Astro.getActionResult(actions.rsvp);
---

<Layout title="RSVP" showLogo>
  <main class="w-sm mx-auto h-full">
    {result && !result.error ? (
      <div class="mt-16 text-orange-500 flex flex-col gap-4">
        {result.data.attending ? (
          <>
            <p class="text-6xl">🎉</p>
            <p class="text-2xl italic text-pretty">
              Thank you! We can't wait to see you next summer.
            </p>
          </>
        ) : (
          <p class="text-2xl italic text-pretty">
            Thanks for letting us know. We'll miss you!
          </p>
        )}
        <a href="/info" class="block mt-4 underline">
          Learn more about the day here
        </a>
        <p class="mt-4">
          <em class="text-taupe-400">P.S. More details to follow by email soon</em>
        </p>
      </div>
    ) : (
      <form
        method="POST"
        action={actions.rsvp}
        class="flex flex-col gap-6 my-auto mt-16"
      >
        <p>
           Ceremony at{" "}
            <a
              class="link"
              href="https://maps.app.goo.gl/XV1HSCgVGFwCbMTC7"
              target="_blank"
            >
              St Nicholas Church
            </a>, BS1 1UE.<br/>
            Followed by the reception at{" "}
            <a class="link" href="https://maps.app.goo.gl/8ogbUCNmDuMyU1qM9" target="_blank">
              Mud Dock Café
            </a>, BS1 4RB
        </p>
        <p>
          <em class="text-taupe-400">Please RSVP by January 31st 2027</em>
        </p>

        {result?.error && (
          <p class="text-orange-600 italic text-balance">
            {result.error.code === "BAD_REQUEST"
              ? "Please check the form and try again."
              : result.error.message}
          </p>
        )}
        <div class="flex flex-col">
          <label for="name">
            Names of guest(s)<span class="text-orange-600">*</span>
          </label>
          <textarea
            name="name"
            id="name"
            placeholder="Your names"
            required
          ></textarea>
        </div>
        <div class="flex flex-col">
          <label for="email">
            Email<span class="text-orange-600">*</span>
          </label>
          <input
            type="email"
            name="email"
            id="email"
            placeholder="Your email"
            required
          />
        </div>
        <fieldset class="flex flex-wrap gap-4">
          <legend class="w-full">
            Can you attend?<span class="text-orange-600">*</span>
          </legend>
          <label class="mt-1" for="yes">
            Yes
          </label>
          <input type="radio" name="rsvp" value="yes" id="yes" required />
          <label class="mt-1" for="no">
            No
          </label>
          <input type="radio" name="rsvp" value="no" id="no" />
        </fieldset>
        <div class="flex flex-col if-attending">
          <label for="dietaries">Any Dietaries</label>
          <input
            type="text"
            name="dietaries"
            id="dietaries"
            placeholder="e.g Vegan or gluten free"
          />
        </div>
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="website">Website</label>
          <input
            type="text"
            name="website"
            id="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <button type="submit" class="disabled:opacity-60 disabled:cursor-wait p-4 bg-orange-500 font-serif font-bold text-xl rounded-full text-orange-50 leading-none flex items-center justify-center">
          Submit your RSVP
        </button>
      </form>
    )}
  </main>
</Layout>

<script>
  // Stop double taps sending the RSVP twice while the server talks to Sheets.
  const form = document.querySelector<HTMLFormElement>("form[method=POST]");
  const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");
  const label = button?.textContent;
  form?.addEventListener("submit", (event) => {
    if (button?.disabled) return event.preventDefault();
    if (button) {
      button.disabled = true;
      button.textContent = "Sending…";
    }
  });
  // Re-enable if they come back via the back button (bfcache keeps the disabled state).
  window.addEventListener("pageshow", () => {
    if (button) {
      button.disabled = false;
      button.textContent = label ?? "";
    }
  });
</script>

<style>
  /* Hide the "if you're coming" fields once someone picks No. No JS needed. */
  form:has(#no:checked) .if-attending {
    display: none;
  }
</style>
